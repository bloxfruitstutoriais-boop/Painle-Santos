+    private static final class ReflectionWindowManager {
+        final Object service;
+        final Method setSize;
+        final Method setDensity;
+        final Method clearSize;
+        final Method clearDensity;
+
+        ReflectionWindowManager(Object service, Method setSize, Method setDensity,
+                                Method clearSize, Method clearDensity) {
+            this.service = service;
+            this.setSize = setSize;
+            this.setDensity = setDensity;
+            this.clearSize = clearSize;
+            this.clearDensity = clearDensity;
+        }
+
+        static ReflectionWindowManager connect() {
+            try {
+                Class<?> serviceManager = Class.forName("android.os.ServiceManager");
+                Object binder = serviceManager.getMethod("getService", String.class)
+                        .invoke(null, "window");
+                if (!(binder instanceof IBinder)) {
+                    Log.w(TAG, "ServiceManager não retornou o binder window");
+                    return null;
+                }
+                Class<?> stub = Class.forName("android.view.IWindowManager$Stub");
+                Object service = stub.getMethod("asInterface", IBinder.class)
+                        .invoke(null, binder);
+                Class<?> iWindowManager = Class.forName("android.view.IWindowManager");
+                Method setSize = iWindowManager.getMethod(
+                        "setForcedDisplaySize", int.class, int.class, int.class);
+                Method setDensity = iWindowManager.getMethod(
+                        "setForcedDisplayDensity", int.class, int.class);
+                Method clearSize = iWindowManager.getMethod(
+                        "clearForcedDisplaySize", int.class);
+                Method clearDensity = iWindowManager.getMethod(
+                        "clearForcedDisplayDensity", int.class);
+                Log.i(TAG, "Reflection IWindowManager OK");
+                return new ReflectionWindowManager(service, setSize, setDensity,
+                        clearSize, clearDensity);
+            } catch (ClassNotFoundException e) {
+                Log.w(TAG, "Reflection indisponível: classe não encontrada", e);
+            } catch (NoSuchMethodException e) {
+                Log.w(TAG, "Reflection indisponível: método não encontrado", e);
+            } catch (IllegalAccessException e) {
+                Log.w(TAG, "Reflection indisponível: acesso recusado", e);
+            } catch (InvocationTargetException e) {
+                Log.w(TAG, "Reflection indisponível: InvocationTargetException", e);
+            } catch (Throwable e) {
+                Log.w(TAG, "Reflection indisponível", e);
+            }
+            return null;
+        }
+
+        boolean setSize(int width, int height) {
+            return invoke(setSize, DISPLAY_ID, width, height);
+        }
+
+        boolean setDensity(int density) {
+            return invoke(setDensity, DISPLAY_ID, density);
+        }
+
+        boolean clearSize() {
+            return invoke(clearSize, DISPLAY_ID);
+        }
+
+        boolean clearDensity() {
+            return invoke(clearDensity, DISPLAY_ID);
+        }
+
+        private boolean invoke(Method method, Object... args) {
+            try {
+                method.invoke(service, args);
+                return true;
+            } catch (InvocationTargetException e) {
+                Log.e(TAG, "IWindowManager rejeitou " + method.getName(), e);
+            } catch (IllegalAccessException | SecurityException e) {
+                Log.e(TAG, "IWindowManager sem acesso a " + method.getName(), e);
+            } catch (Throwable e) {
+                Log.e(TAG, "Falha em " + method.getName(), e);
+            }
+            return false;
+        }
+    }
