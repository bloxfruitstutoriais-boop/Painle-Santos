+public final class DisplayManagerHelper {
+    private static final String TAG = "DISPLAY_DEBUG";
+    private static final String SHIZUKU_TAG = "SHIZUKU_DEBUG";
+    private static final String PREFS_NAME = "santos_display_snapshot";
