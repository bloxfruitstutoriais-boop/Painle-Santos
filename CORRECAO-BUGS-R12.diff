+        return LicenseKeyInfo(valid, expiryKnown, expired, trial, fullAccess, days, safeExpiry ?: 0L, currentAtMillis, currentText, expiryText, result) // CORRIGIDO BUG2: devolve um estado imutável para a UI.
+    }
